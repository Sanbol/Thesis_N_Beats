NBEATSS_thesis/data/raw/Monthly-train.csv
data/raw/Daily-train.csv
data/raw/Monthly-train.csv

# Python cache
__pycache__/
*.pyc
*.pyo
__MACOSX/

# Jupyter
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

