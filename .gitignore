NBEATSS_thesis/NBEATSS_thesis/*/

# Processed/cached PyTorch tensors (large)
data/processed/*.pt
NBEATSS_thesis/data/processed/*.pt

# Large raw M4 data files (exceed GitHub 100MB limit)
NBEATSS_thesis/data/raw/Daily-train.csv
data/raw/Daily-train.csv
# Monthly-train.csv is tracked via Git LFS

# Python cache
__pycache__/
*.pyc
*.pyo
__MACOSX/

# Jupyter
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude Code memory (AI assistant files, not thesis code)
.claude/

